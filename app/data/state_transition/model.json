  "formulas": {
    "exclusive_horizon": "cycles = (12 - 1) * 52 = 572; last cycle starts at age 11 + 51/52",
    "weekly_rate": "lambda_week = lambda_annual / 52",
    "event_count": "N[k,i,t] ~ Poisson(lambda[k,weekly])",
    "residual_bleed_rate": "lambda_non_major_non_joint = ABR - AJBR - lambda_ICH - lambda_non_ICH_major",
    "pettersson": "PS = min(78, floor(cumulative_joint_bleeds / joint_bleeds_per_pettersson_point))",
    "weekly_discount": "discount(t) = 1 / (1 + r)^(t/52)",
    "qaly": "QALY_cycle = integral_0^7 U(t) dt / 364",
    "icer": "ICER = (Cost_prophylaxis - Cost_on_demand) / (QALY_prophylaxis - QALY_on_demand)",
    "inmb": "INMB = WTP * incremental_QALY - incremental_cost"
  },
  "validation_rules": [
    "The cohort enters at age 1 and exits before age 12 after exactly 572 weekly cycles.",
    "All event rates are non-negative and event-rate components sum to ABR.",
    "Pettersson score remains in [0, 78] and chronic progression is one-way.",
    "Utilities remain in [0, 1] and overlapping acute effects use the minimum utility.",
    "Costs and factor consumption are non-negative and denominated in IRR and IU.",
    "Death is absorbing and assigned to exactly one cause: background mortality or fatal ICH.",
    "Alive plus background deaths plus ICH deaths equals the initial cohort.",
    "Paired strategies use identical first-order stream identifiers."
  ]
}
